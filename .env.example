# Shared passcode you and the cafe owner use to log in
APP_PASSCODE=change-me
# Secret used to sign the login cookie
SESSION_SECRET=long-random-string
# Protects the daily cron endpoint
CRON_SECRET=another-long-random-string
# SQLite file location
DATABASE_PATH=./data/cafe.db
# SMTP settings for the daily email (e.g. Gmail app password, Brevo, Resend SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=app-password
SMTP_FROM="Cafe Tab <you@example.com>"
